# Database (SQLite by default, no external DB needed)
DATABASE_URL=sqlite+aiosqlite:///./ninaivugal.db

# Ollama local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# FAISS index paths
FAISS_INDEX_PATH=memory.index
FAISS_META_PATH=memory_meta.pkl

# Account Auth & Storage (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ninaivugal
JWT_SECRET_KEY=your_super_secret_jwt_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Voice Pipeline Core
GROQ_API_KEY=your_groq_whisper_api_key
GEMINI_API_KEY=your_google_gemini_api_key
